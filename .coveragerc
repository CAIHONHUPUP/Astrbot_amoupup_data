[run]
source = .
omit =
    tests/*
    tools/*
    __pycache__/*
    _test_tmp/*
    work/*
    store_types.py
    run_tests.py

[report]
# 测试会临时生成/删除探针文件，报告时找不到源码直接跳过（2026-11-19）。
ignore_errors = true
# 类型检查之外再加覆盖率底线。
# 2026-11-24：测试从旧 store 布局迁到 services/core 布局后重算：
#   只迁时间/召回 → 11%；补身份/跨平台 → 30%；pid 自愈/消息接口/群私聊隔离 → 37%；
#   补召回闸门/去重/生命周期 → 38%；补摘要颗粒度/人物档案 → 40%；补画像删除同步 → 43%；
#   补 MemoryAPI 门面 + embedding 降级 → 50%；补群名/压缩/时间解析补充 → 52%。
#   底线跟着实测走（留 2 点），只许往上。
# 用户明确「没必要强制要求 88」，这里不追旧数字，只做「不许掉」的保险。
fail_under = 50
show_missing = True
skip_covered = True
